# ====================================================================
# SAVR Environment Variables Configuration
# ====================================================================
# This file contains all environment variables needed for local development
# and Firebase Functions runtime. For GitHub Actions secrets setup, see:
# GITHUB_SECRETS_SETUP.md
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local for Next.js web app
# 2. Replace placeholder values with your actual credentials
# 3. Never commit .env.local to version control (it's in .gitignore)
# ====================================================================

# ====================================================================
# FIREBASE CONFIGURATION (Required - Public)
# ====================================================================
# Get these from Firebase Console > Project Settings > Your apps
# These values are safe to expose in client-side code
# Source: https://console.firebase.google.com/

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ====================================================================
# OPENAI CONFIGURATION (Required - Sensitive)
# ====================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Used for: Image analysis, recipe generation, meal planning, AI chat
# IMPORTANT: Keep this secret! Never commit to code or expose client-side

OPENAI_API_KEY=your_openai_api_key

# ====================================================================
# GOOGLE CLOUD VISION API (Optional - Sensitive)
# ====================================================================
# Get from: https://console.cloud.google.com/ > APIs & Services > Credentials
# Used as fallback for image analysis if OpenAI Vision fails
# IMPORTANT: Keep this secret!

GOOGLE_CLOUD_VISION_API_KEY=your_google_vision_api_key

# ====================================================================
# STRIPE CONFIGURATION (Required - Mixed Sensitivity)
# ====================================================================
# Get from: https://dashboard.stripe.com/apikeys
# Publishable key: Safe to expose client-side
# Secret key: SENSITIVE - keep private!
# Webhook secret: Get from Stripe Dashboard > Webhooks

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ====================================================================
# STRIPE PRICE IDs (Required - Public)
# ====================================================================
# Get from: https://dashboard.stripe.com/products
# These are your Stripe subscription product price IDs
# Create 4 products with these pricing tiers:

# Basic Monthly: $5.99/month - 50 items, 10 recipes/month, 2 meal plans/month
STRIPE_PRICE_ID_BASIC_MONTHLY=price_basic_monthly
NEXT_PUBLIC_STRIPE_PRICE_ID_BASIC_MONTHLY=price_basic_monthly

# Basic Yearly: $69.99/year - Same as Basic Monthly, save ~$2/year
STRIPE_PRICE_ID_BASIC_YEARLY=price_basic_yearly
NEXT_PUBLIC_STRIPE_PRICE_ID_BASIC_YEARLY=price_basic_yearly

# Pro Monthly: $9.99/month - Unlimited inventory, recipes, meal plans, AI chat
STRIPE_PRICE_ID_PRO_MONTHLY=price_pro_monthly
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_MONTHLY=price_pro_monthly

# Pro Yearly: $99.99/year - Same as Pro Monthly, save ~$20/year
STRIPE_PRICE_ID_PRO_YEARLY=price_pro_yearly
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO_YEARLY=price_pro_yearly

# ====================================================================
# APPLICATION CONFIGURATION (Required - Public)
# ====================================================================
# Your production domain URL (no trailing slash)

NEXT_PUBLIC_APP_URL=https://www.SAVR.cam

# ====================================================================
# VARIABLE SUMMARY
# ====================================================================
# Total: 18 variables
# - Firebase Config: 6 (public)
# - OpenAI: 1 (sensitive)
# - Google Vision: 1 (sensitive, optional)
# - Stripe Keys: 3 (2 sensitive, 1 public)
# - Stripe Prices: 8 (public)
# - App Config: 1 (public)
#
# Sensitive variables: OPENAI_API_KEY, GOOGLE_CLOUD_VISION_API_KEY, 
#                     STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# ====================================================================
