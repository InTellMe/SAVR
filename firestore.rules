rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper: paid tier (all tiers are now paid: basic and pro; legacy 'free'/'plus'/'premium' also treated as paid)
    function isPaidTier() {
      let tier = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionTier;
      return isAuthenticated() && (tier == 'basic' || tier == 'pro' || tier == 'free' || tier == 'plus' || tier == 'premium');
    }
    
    // Users collection - users can read their own profile and only update non-entitlement fields.
    // subscriptionTier, subscriptionStatus, stripeCustomerId, paypalSubscriptionId are
    // updated only by Cloud Functions (Stripe and PayPal webhooks); clients cannot write them.
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Creation and deletion are handled by backend (admin SDK / Cloud Functions)
      allow create, delete: if false;

      // Users may update profile fields (e.g., displayName, photoURL) but cannot change
      // subscription tier/status or payment identifiers.
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.subscriptionTier == resource.data.subscriptionTier
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.stripeCustomerId == resource.data.stripeCustomerId;
    }
    
    // Inventory collection - users can manage their own inventory under their UID
    match /inventory/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    // Recipes collection - users can manage their own recipes under their UID
    match /recipes/{userId}/items/{recipeId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    // Meal plans collection - users can manage their own meal plans under their UID
    match /mealPlans/{userId}/plans/{planId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    // Grocery lists collection - users can manage their own grocery lists under their UID
    match /groceryLists/{userId}/lists/{listId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    // Chat history - users can access their own chat history under their UID
    match /chatHistory/{userId}/messages/{messageId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    // Subscription data - only readable by owner; written only by Cloud Functions (webhooks)
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // API usage (rate limiting) - written only by Cloud Functions
    match /apiUsage/{userId} {
      allow read, write: if false;
    }

    // Shared recipes - public read by shareId; only owner can create/update/delete
    match /sharedRecipes/{shareId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Labeled training data - only backend services (admin SDK) may access
    match /labeled_data/{rowId} {
      allow read, write: if false;
    }
  }
}
