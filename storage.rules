rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload and read their own inventory images
    match /inventory/{userId}/{imageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow write: if request.resource.size < 10 * 1024 * 1024 // Max 10MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Profile images
    match /profile-images/{userId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Dataset labeling images
    match /images/{userId}/{imageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 20 * 1024 * 1024 // Max 20MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Thumbnails (readable by owner)
    match /thumbnails/{imageId} {
      allow read: if request.auth != null;
      // Thumbnails are created server-side, no direct write access
    }
    
    // Videos for labeling
    match /videos/{userId}/{videoId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024 // Max 100MB
                   && request.resource.contentType.matches('video/.*');
    }
    
    // Masks (optional, created server-side)
    match /masks/{imageId}/{annotationId}/{objectId} {
      allow read: if request.auth != null;
      // Masks are created server-side, no direct write access
    }
  }
}
