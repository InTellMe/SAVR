# ====================================================================
# SAVR GitHub Actions Secrets and Variables
# ====================================================================
# This file lists all GitHub Actions secrets and variables required for
# CI/CD workflows in the SAVR repository.
#
# IMPORTANT: This is a REFERENCE file, NOT for local development!
# - Do NOT add actual secret values to this file
# - Use this as a checklist when configuring GitHub repository secrets
# - For local development, use .env.example instead
#
# HOW TO USE:
# 1. Go to GitHub Repository Settings → Secrets and variables → Actions
# 2. Add secrets to the "Production" Environment (for Firebase deployment)
# 3. Add secrets to "Repository secrets" (for Mobile builds)
# 4. Replace placeholder values with your actual credentials
# 5. See GITHUB_SECRETS_SETUP.md for detailed setup instructions
# ====================================================================

# ====================================================================
# FIREBASE DEPLOYMENT SECRETS (Add to Production Environment)
# ====================================================================
# Location: Repository → Settings → Environments → Production → Secrets
# Used by: .github/workflows/firebase-deploy.yml
# ====================================================================

# --------------------------------------------------------------------
# Firebase Authentication (Choose ONE method)
# --------------------------------------------------------------------
# Method 1: Token-Based (Recommended for quick setup)
# Generate with: firebase login:ci
# FIREBASE_TOKEN=1//0gABCDEFGHIJKLMNOPQRSTUVWXYZ...

# Method 2: Service Account JSON (Recommended for production)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# --------------------------------------------------------------------
# Firebase Project Configuration
# --------------------------------------------------------------------
# Get from: Firebase Console → Project Settings
FIREBASE_PROJECT_ID=your_firebase_project_id

# --------------------------------------------------------------------
# Firebase Public Configuration (Safe to expose client-side)
# --------------------------------------------------------------------
# Get from: Firebase Console → Project Settings → Your apps → Web app config
# These are public values that will be embedded in the web app JavaScript
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyABCDEFGHIJKLMNOPQRSTUVWXYZ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# --------------------------------------------------------------------
# Stripe Configuration (Public - Safe to expose)
# --------------------------------------------------------------------
# Get from: Stripe Dashboard → Developers → API keys
# Publishable key is safe to expose client-side
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXX

# Get from: Stripe Dashboard → Products → Pricing Tables
# The pricing table ID (starts with prctbl_)
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=prctbl_XXXXXXXXXXXXXXXX

# --------------------------------------------------------------------
# Application URL
# --------------------------------------------------------------------
# Your production domain (no trailing slash)
NEXT_PUBLIC_APP_URL=https://savr.cam

# ====================================================================
# MOBILE BUILD SECRETS (Add to Repository Secrets)
# ====================================================================
# Location: Repository → Settings → Secrets and variables → Actions → Repository secrets
# Used by: .github/workflows/mobile-build.yml
# ====================================================================

# --------------------------------------------------------------------
# Expo Configuration
# --------------------------------------------------------------------
# Get from: https://expo.dev → Account Settings → Access Tokens
# Required for EAS Build and submission
EXPO_TOKEN=your_expo_access_token_here

# --------------------------------------------------------------------
# Google Play Store Configuration (Optional - for production submission)
# --------------------------------------------------------------------
# Get from: Google Play Console → Setup → API access → Service account
# Required only if you want to automatically submit builds to Google Play
# This should be the entire JSON content of the service account key file
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ====================================================================
# RUNTIME SECRETS (NOT GitHub Secrets)
# ====================================================================
# These are NOT configured in GitHub Actions
# Configure these separately in Firebase Functions or local .env files
# See .env.example for local development configuration
# ====================================================================

# Firebase Functions Runtime (Configure via Firebase CLI or Console):
# - OPENAI_API_KEY (sensitive - OpenAI API key)
# - GOOGLE_CLOUD_VISION_API_KEY (sensitive - optional fallback)
# - STRIPE_SECRET_KEY (sensitive - Stripe secret key)
# - STRIPE_WEBHOOK_SECRET (sensitive - Stripe webhook signing secret)

# ====================================================================
# QUICK REFERENCE: SECRET LOCATIONS
# ====================================================================

# Production Environment Secrets (11 total):
# ✓ FIREBASE_TOKEN or FIREBASE_SERVICE_ACCOUNT_JSON (choose one)
# ✓ FIREBASE_PROJECT_ID
# ✓ NEXT_PUBLIC_FIREBASE_API_KEY
# ✓ NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
# ✓ NEXT_PUBLIC_FIREBASE_PROJECT_ID
# ✓ NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
# ✓ NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
# ✓ NEXT_PUBLIC_FIREBASE_APP_ID
# ✓ NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# ✓ NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID
# ✓ NEXT_PUBLIC_APP_URL

# Repository Secrets (2 total):
# ✓ EXPO_TOKEN
# ✓ GOOGLE_PLAY_SERVICE_ACCOUNT_KEY (optional, only for automatic Play Store submission)

# ====================================================================
# SENSITIVITY LEVELS
# ====================================================================

# HIGHLY SENSITIVE (Never expose, keep private):
# - FIREBASE_TOKEN
# - FIREBASE_SERVICE_ACCOUNT_JSON
# - EXPO_TOKEN
# - GOOGLE_PLAY_SERVICE_ACCOUNT_KEY
# - OPENAI_API_KEY (runtime)
# - STRIPE_SECRET_KEY (runtime)
# - STRIPE_WEBHOOK_SECRET (runtime)

# PUBLIC (Safe to expose in client-side code):
# - All NEXT_PUBLIC_* variables
# - These are designed to be public and are protected by backend security

# ====================================================================
# WORKFLOW USAGE
# ====================================================================

# firebase-deploy.yml requires:
# - FIREBASE_TOKEN or FIREBASE_SERVICE_ACCOUNT_JSON
# - FIREBASE_PROJECT_ID
# - All 6 NEXT_PUBLIC_FIREBASE_* variables
# - Both NEXT_PUBLIC_STRIPE_* variables
# - NEXT_PUBLIC_APP_URL
# Total: 11 secrets

# mobile-build.yml requires:
# - EXPO_TOKEN
# - All 6 NEXT_PUBLIC_FIREBASE_* variables (mapped to EXPO_PUBLIC_*)
# - GOOGLE_PLAY_SERVICE_ACCOUNT_KEY (only for production submission)
# Total: 8 secrets (or 7 if not doing automatic submission)

# ====================================================================
# SETUP INSTRUCTIONS
# ====================================================================

# 1. For Firebase Deployment:
#    - Navigate to: Repository → Settings → Environments
#    - Create/select "Production" environment (exact name, capital P)
#    - Add the 11 Firebase deployment secrets listed above

# 2. For Mobile Builds:
#    - Navigate to: Repository → Settings → Secrets and variables → Actions
#    - Click "Repository secrets"
#    - Add EXPO_TOKEN
#    - Optionally add GOOGLE_PLAY_SERVICE_ACCOUNT_KEY for auto-submission

# 3. Verify Setup:
#    - Check that all secrets are listed in their correct locations
#    - Trigger a deployment to test (push to main or re-run workflow)

# 4. For Detailed Instructions:
#    - See GITHUB_SECRETS_SETUP.md in repository root
#    - Contains step-by-step guides for obtaining each secret value

